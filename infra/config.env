# =============================================================================
# Project name — change this ONE value when renaming the project.
# Then keep Terraform + Helm in sync (see below).
# =============================================================================
NAME_PREFIX=template

# Derived names (do not edit — for reference / CI docs):
#   Helm release:     ${NAME_PREFIX}-app      → template-app
#   K8s namespace:     ${NAME_PREFIX}          → template
#   GAR repository:   ${NAME_PREFIX}-containers
#   GKE cluster:      ${NAME_PREFIX}-gke
#   Workload KSA:     ${NAME_PREFIX}-app
#
# Wire-up:
#   Terraform  → name_prefix        = "<same as NAME_PREFIX>"
#   Helm       → global.namePrefix  = "<same as NAME_PREFIX>"
#   GitHub     → HELM_RELEASE_NAME  = "<NAME_PREFIX>-app"
#                HELM_NAMESPACE     = "<NAME_PREFIX>"
#                GAR_REPOSITORY     = "<NAME_PREFIX>-containers"
