# App origin (used to resolve relative API paths during SSR)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Browser same-origin API prefix (ingress routes /api → FastAPI in prod)
NEXT_PUBLIC_API_BASE_URL=/api

# Absolute FastAPI base for server-side fetch (RSC). Required for Backend health.
BACKEND_URL=http://127.0.0.1:8000

# Local Postgres (match your host port; example uses 5420)
DATABASE_URL=postgresql://postgres:postgres@localhost:5420/postgres
